+
+// Opciones de línea de comandos (parche Sysmic): velocidad de simulación y puertos por
+// instancia, para correr partidos acelerados y varias instancias en paralelo.
+void MainWindow::applyCliOptions(int fps, int visionPort, int cmdPort)
+{
+    if (fps > 0) {
+        configwidget->v_DesiredFPS->setDouble(fps);
+        customFPS(fps);
+    }
+    if (visionPort > 0) {
+        configwidget->v_VisionMulticastPort->setInt(visionPort);
+        reconnectVisionSocket();
+    }
+    if (cmdPort > 0) {
+        configwidget->v_CommandListenPort->setInt(cmdPort);
+        reconnectCommandSocket();
+    }
+}
